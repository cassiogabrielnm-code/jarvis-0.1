<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JARVIS 0.1"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pronto."
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />
        <Button
            android:id="@+id/listenButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎙️ Falar com JARVIS"
            android:minHeight="56dp" />
        <Button
            android:id="@+id/timeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕐 Que horas são?"
            android:layout_marginTop="10dp"
            android:minHeight="52dp" />
        <Button
            android:id="@+id/calculatorButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧮 Abrir calculadora"
            android:layout_marginTop="10dp"
            android:minHeight="52dp" />
        <Button
            android:id="@+id/youtubeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶️ Abrir YouTube"
            android:layout_marginTop="10dp"
            android:minHeight="52dp" />
        <Button
            android:id="@+id/cameraButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📷 Abrir câmera"
            android:layout_marginTop="10dp"
            android:minHeight="52dp" />
        <Button
            android:id="@+id/browserButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌐 Abrir navegador"
            android:layout_marginTop="10dp"
            android:minHeight="52dp" />
        <Button
            android:id="@+id/galleryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🖼️ Abrir galeria"
            android:layout_marginTop="10dp"
            android:minHeight="52dp" />
        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ Abrir configurações"
            android:layout_marginTop="10dp"
            android:minHeight="52dp"
            android:layout_marginBottom="20dp" />
    </LinearLayout>
</ScrollView>